{
  "schema": "pr-guard/v1",
  "a38": {
    "enforce": ["develop"],
    "exclude": ["main"],
    "default": "enforce"
  },
  "workflow_approval": {
    "enabled": true,
    "workflows": [".github/workflows/quality.yml", ".github/workflows/visual.yml"]
  },
  "lifecycle": {
    "enabled": true,
    "auto_ready": true,
    "required_workflows": [".github/workflows/quality.yml", ".github/workflows/visual.yml"],
    "ignored_workflows": [".github/workflows/a38-guard.yml"],
    "required_checks": {
      ".github/workflows/quality.yml": ["Quality"],
      ".github/workflows/visual.yml": ["Screenshots"]
    }
  }
}
